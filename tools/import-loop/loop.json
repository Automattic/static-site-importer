{
  "schema": "homeboy/workflow/v1",
  "id": "import-findings-loop",
  "inputs": {
    "url": {
      "required": true
    },
    "loop_dir": {
      "required": true
    },
    "runs_dir": {
      "required": true
    },
    "blocks_engine": {
      "required": true
    },
    "slug": {
      "required": true
    },
    "wp_cli": {
      "default": "studio wp"
    },
    "cook_model": {
      "required": true
    },
    "cook_placement": {
      "default": "auto"
    }
  },
  "env": {
    "public": [
      "PATH",
      "HOME"
    ]
  },
  "budget": {
    "max_step_runs": 40,
    "deadline": "36h"
  },
  "steps": [
    {
      "id": "import",
      "timeout": "60m",
      "retry": {
        "max": 8,
        "on": [
          "failed",
          "timed_out"
        ],
        "backoff": "5m"
      },
      "exec": {
        "program": "bash",
        "cwd": "{{inputs.loop_dir}}",
        "args": [
          "import.sh",
          "{{inputs.url}}",
          "{{inputs.runs_dir}}/{{inputs.slug}}-p{{inputs.iteration}}",
          "{{inputs.runs_dir}}/{{inputs.slug}}-capture",
          "{{inputs.blocks_engine}}"
        ]
      }
    },
    {
      "id": "evaluate",
      "needs": [
        "import"
      ],
      "timeout": "45m",
      "retry": {
        "max": 2,
        "on": [
          "failed",
          "timed_out"
        ],
        "backoff": "1m"
      },
      "exec": {
        "program": "node",
        "cwd": "{{inputs.loop_dir}}",
        "args": [
          "evaluate.mjs",
          "--url",
          "{{inputs.url}}",
          "--wp-url",
          "{{steps.import.output/site_url}}",
          "--site",
          "{{steps.import.output/site}}",
          "--source",
          "{{steps.import.output/source}}",
          "--out",
          "{{inputs.runs_dir}}/{{inputs.slug}}-p{{inputs.iteration}}-eval",
          "--wp-cli",
          "{{steps.import.output/wp_cli}}"
        ]
      }
    },
    {
      "id": "triage",
      "needs": [
        "evaluate"
      ],
      "timeout": "12h",
      "when": {
        "step": "evaluate",
        "output": "/blocker_count",
        "gt": 0
      },
      "exec": {
        "program": "node",
        "cwd": "{{inputs.loop_dir}}",
        "args": [
          "triage.mjs",
          "--findings",
          "{{steps.evaluate.output/findings_path}}",
          "--source",
          "{{steps.import.output/source}}",
          "--ssi-zip",
          "{{steps.import.output/ssi_zip}}",
          "--trunk",
          "{{steps.import.output/blocks_engine}}",
          "--work",
          "{{inputs.runs_dir}}/{{inputs.slug}}-p{{inputs.iteration}}-triage",
          "--blocks-engine",
          "{{inputs.blocks_engine}}",
          "--iteration",
          "{{inputs.iteration}}",
          "--wp-cli",
          "{{inputs.wp_cli}}"
        ]
      },
      "retry": {
        "max": 2,
        "on": [
          "failed",
          "timed_out"
        ],
        "backoff": "2m"
      }
    },
    {
      "id": "cook",
      "needs": [
        "triage"
      ],
      "timeout": "8h",
      "when": {
        "step": "triage",
        "output": "/cook_count",
        "gt": 0
      },
      "foreach": "{{steps.triage.output/cook_items}}",
      "max_parallel": 4,
      "join": {
        "min_succeeded": 0
      },
      "cook": {
        "repo": "{{item.repo}}",
        "task-url": "{{item.issue_url}}",
        "prompt": "{{item.prompt}}",
        "verify": "{{item.verify}}",
        "placement": "{{inputs.cook_placement}}",
        "model": "{{inputs.cook_model}}",
        "acknowledge-model-override": true,
        "provider-evidence": "{{item.provider_evidence}}",
        "gate-input": "{{item.gate_inputs}}",
        "gate-env-from": "PLAYWRIGHT_BROWSERS_PATH=HOME/.cache/ms-playwright",
        "gate-toolchain": [
          "node",
          "php"
        ],
        "publish-incomplete-draft": true,
        "timeout-ms": 2400000,
        "gate-timeout-seconds": "5400"
      }
    },
    {
      "id": "confirm",
      "needs": [
        "triage",
        "cook"
      ],
      "always": true,
      "timeout": "2h",
      "when": {
        "step": "triage",
        "output": "/continue",
        "equals": true
      },
      "exec": {
        "program": "node",
        "cwd": "{{inputs.loop_dir}}",
        "args": [
          "confirm.mjs",
          "--triage",
          "{{inputs.runs_dir}}/{{inputs.slug}}-p{{inputs.iteration}}-triage/triage.json",
          "--blocks-engine",
          "{{inputs.blocks_engine}}",
          "--work",
          "{{inputs.runs_dir}}/{{inputs.slug}}-p{{inputs.iteration}}-confirm",
          "--wp-cli",
          "{{inputs.wp_cli}}"
        ]
      },
      "retry": {
        "max": 2,
        "on": [
          "failed",
          "timed_out"
        ],
        "backoff": "2m"
      }
    },
    {
      "id": "merge",
      "needs": [
        "confirm"
      ],
      "always": true,
      "when": {
        "all": [
          {
            "step": "triage",
            "output": "/continue",
            "equals": true
          },
          {
            "step": "confirm",
            "output": "/merge_count",
            "gt": 0
          }
        ]
      },
      "foreach": "{{steps.confirm.output/merge}}",
      "join": {
        "min_succeeded": 0
      },
      "timeout": "65m",
      "homeboy": [
        "git",
        "pr",
        "merge-when-green",
        "--repo",
        "{{item.github}}",
        "--number",
        "{{item.number}}",
        "--sha",
        "{{item.sha}}",
        "--wait-seconds",
        "3600"
      ]
    },
    {
      "id": "score",
      "needs": [
        "merge"
      ],
      "always": true,
      "timeout": "10m",
      "exec": {
        "program": "node",
        "cwd": "{{inputs.loop_dir}}",
        "args": [
          "score.mjs",
          "--instance",
          "{{instance}}",
          "--runs",
          "{{inputs.runs_dir}}",
          "--slug",
          "{{inputs.slug}}",
          "--iteration",
          "{{inputs.iteration}}"
        ]
      }
    }
  ],
  "next_pass": {
    "max_iterations": 60,
    "when": {
      "step": "triage",
      "output": "/continue",
      "equals": true
    },
    "stop_unchanged": {
      "step": "evaluate",
      "output": "/blocker_signatures",
      "passes": 3
    }
  }
}
