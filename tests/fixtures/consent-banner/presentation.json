{
  "schema": "static-site-importer/consent-banner/v1",
  "text": "This example uses cookies for analytics & preferences.",
  "accept_label": "Accept cookies",
  "policy_link": {
    "label": "Privacy policy",
    "href": "https://example.test/privacy/"
  },
  "position": "bottom",
  "colors": {
    "background": "#222222",
    "text": "#ffffff",
    "button_background": "#999999",
    "button_text": "#ffffff"
  },
  "source_selector": ".example-consent",
  "presentation": {
    "span": "full",
    "edge_offset": "0px",
    "padding": "12px",
    "font_family": "Calibri, sans-serif",
    "font_size": "15px",
    "line_height": "18px",
    "text_margin": "0px",
    "layout": [
      { "max_width": 767, "direction": "column", "button_align": "end", "text_margin": "0 0 15px" },
      { "min_width": 768, "direction": "row", "align_items": "center", "text_margin": "0 15px 0 0" }
    ],
    "button": {
      "border_radius": "5px",
      "border_width": "2px",
      "border_style": "solid",
      "border_color": "#777777",
      "padding": "8px 40px",
      "font_size": "13.5px",
      "line_height": "16.2px"
    }
  }
}
